@{



    ViewData["Title"] = "Lecturer Profile";



    var lecturerName = ViewBag.Name?.ToString();



    if (string.IsNullOrWhiteSpace(lecturerName))



    {



        lecturerName = Context.Session.GetString("UserName") ?? "Lecturer";



    }



    var lecturerEmail = ViewBag.Email?.ToString();



    if (string.IsNullOrWhiteSpace(lecturerEmail))



    {



        lecturerEmail = Context.Session.GetString("UserEmail") ?? "";



    }



    var lecturerRole = ViewBag.Role?.ToString();



    if (string.IsNullOrWhiteSpace(lecturerRole))



    {



        lecturerRole = Context.Session.GetString("Role") ?? "lecturer";



    }



    string? profileImage = ViewBag.ProfileImage as string;



    int activeCourses = ViewBag.ProfileCourseCount != null



        ? Convert.ToInt32(ViewBag.ProfileCourseCount)



        : 0;



    int totalStudents = ViewBag.ProfileStudentCount != null



        ? Convert.ToInt32(ViewBag.ProfileStudentCount)



        : 0;



    int quizAttempts = ViewBag.ProfileQuizAttemptCount != null



        ? Convert.ToInt32(ViewBag.ProfileQuizAttemptCount)



        : 0;



}



<div class="portal-page">



    <!-- BACK -->



    <div class="portal-back-row">



        <button type="button"



                class="portal-back-button"



                onclick="window.history.back();">



            <i class="bi bi-arrow-left"></i>



            <span>Back</span>



        </button>



    </div>



    <!-- PAGE HEADER -->



    <section class="portal-page-heading">



        <div>



            <span class="page-eyebrow">MY ACCOUNT</span>



            <h1>Lecturer Profile</h1>



            <p>View your account information and teaching overview.</p>



        </div>



        <div class="page-heading-icon">



            <i class="bi bi-person-fill"></i>



        </div>



    </section>



    @if (TempData["ProfileSuccess"] != null)

    {

        <div class="alert alert-success" role="alert">

            <i class="bi bi-check-circle-fill"></i>

            <span>@TempData["ProfileSuccess"]</span>

        </div>

    }



    @if (TempData["ProfileError"] != null)

    {

        <div class="alert alert-danger" role="alert">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>@TempData["ProfileError"]</span>

        </div>

    }



    @if (ViewBag.DatabaseError != null)



    {



        <div class="alert alert-danger" role="alert">



            <i class="bi bi-exclamation-triangle-fill"></i>



            <span>@ViewBag.DatabaseError</span>



        </div>



    }



    <!-- PROFILE WORKSPACE -->



    <div class="lecturer-profile-grid">



        <!-- LEFT PROFILE CARD -->



        <section class="lecturer-profile-card">



            <div class="profile-hero">



                <div class="profile-hero-decoration">



                    <i class="bi bi-mortarboard-fill"></i>



                </div>



            </div>



            <div class="profile-content">



                <div class="profile-identity-row">



                    <div class="profile-large-avatar">

                        @if (!string.IsNullOrWhiteSpace(profileImage))

                        {

                            <img src="@profileImage"

                                 alt="@lecturerName Profile Picture"

                                 style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />

                        }

                        else

                        {

                            <i class="bi bi-person-fill"></i>

                        }

                    </div>



                    <div class="profile-identity">



                        <span class="dashboard-small-label">



                            LECTURER ACCOUNT



                        </span>



                        <h2>@lecturerName</h2>



                        <p>@lecturerEmail</p>



                        <span class="profile-role-badge">



                            <i class="bi bi-person-badge-fill"></i>



                            @lecturerRole



                        </span>



                    </div>



                </div>



                <form asp-controller="Lecturer"

                      asp-action="UploadProfilePicture"

                      method="post"

                      enctype="multipart/form-data"

                      style="margin-bottom:24px;">

                    @Html.AntiForgeryToken()



                    <label for="profilePicture"

                           class="btn btn-outline-primary"

                           style="cursor:pointer;">

                        <i class="bi bi-camera-fill"></i>

                        Choose Profile Picture

                    </label>



                    <input type="file"

                           id="profilePicture"

                           name="profilePicture"

                           accept=".jpg,.jpeg,.png,.webp"

                           style="display:block; margin-top:10px;"

                           required />



                    <small style="display:block; margin-top:8px;">

                        JPG, PNG or WEBP · Maximum 5 MB

                    </small>



                    <button type="submit"

                            class="btn btn-primary"

                            style="margin-top:12px;">

                        <i class="bi bi-cloud-arrow-up-fill"></i>

                        Upload Picture

                    </button>

                </form>



                <!-- ACCOUNT DETAILS -->



                <div class="profile-information">



                    <div class="profile-information-heading">



                        <div>



                            <span class="dashboard-small-label">



                                ACCOUNT INFORMATION



                            </span>



                            <h3>Personal Details</h3>



                        </div>



                        <div class="small-card-icon">



                            <i class="bi bi-person-lines-fill"></i>



                        </div>



                    </div>



                    <div class="profile-detail-grid">



                        <div class="profile-detail-item">



                            <div class="profile-detail-icon">



                                <i class="bi bi-person-fill"></i>



                            </div>



                            <div>



                                <span>Full Name</span>



                                <strong>@lecturerName</strong>



                            </div>



                        </div>



                        <div class="profile-detail-item">



                            <div class="profile-detail-icon">



                                <i class="bi bi-envelope-fill"></i>



                            </div>



                            <div>



                                <span>Email Address</span>



                                <strong>@lecturerEmail</strong>



                            </div>



                        </div>



                        <div class="profile-detail-item">



                            <div class="profile-detail-icon">



                                <i class="bi bi-person-badge-fill"></i>



                            </div>



                            <div>



                                <span>Account Role</span>



                                <strong>@lecturerRole</strong>



                            </div>



                        </div>



                        <div class="profile-detail-item">



                            <div class="profile-detail-icon">



                                <i class="bi bi-check-circle-fill"></i>



                            </div>



                            <div>



                                <span>Account Status</span>



                                <strong class="profile-active-text">



                                    Active



                                </strong>



                            </div>



                        </div>



                    </div>



                </div>



            </div>



        </section>



        <!-- RIGHT COLUMN -->



        <aside class="lecturer-profile-side">



            <!-- TEACHING OVERVIEW -->



            <section class="profile-side-card">



                <div class="dashboard-card-header">



                    <div>



                        <span class="dashboard-small-label">



                            OVERVIEW



                        </span>



                        <h2>Teaching Overview</h2>



                        <p>



                            Your current academic activity.



                        </p>



                    </div>



                    <div class="small-card-icon">



                        <i class="bi bi-bar-chart-fill"></i>



                    </div>



                </div>



                <div class="profile-overview-list">



                    <div class="profile-overview-row">



                        <div class="profile-overview-icon overview-blue">



                            <i class="bi bi-book-half"></i>



                        </div>



                        <div>



                            <span>Active Courses</span>



                            <strong>@activeCourses</strong>



                        </div>



                        <i class="bi bi-chevron-right"></i>



                    </div>



                    <div class="profile-overview-row">



                        <div class="profile-overview-icon overview-purple">



                            <i class="bi bi-people-fill"></i>



                        </div>



                        <div>



                            <span>Total Students</span>



                            <strong>@totalStudents</strong>



                        </div>



                        <i class="bi bi-chevron-right"></i>



                    </div>



                    <div class="profile-overview-row">



                        <div class="profile-overview-icon overview-orange">



                            <i class="bi bi-ui-checks-grid"></i>



                        </div>



                        <div>



                            <span>Quiz Attempts</span>



                            <strong>@quizAttempts</strong>



                        </div>



                        <i class="bi bi-chevron-right"></i>



                    </div>



                </div>



            </section>



            <!-- QUICK ACCESS -->



            <section class="profile-side-card">



                <div class="dashboard-card-header">



                    <div>



                        <span class="dashboard-small-label">



                            QUICK ACCESS



                        </span>



                        <h2>Lecturer Tools</h2>



                        <p>



                            Access your teaching workspace.



                        </p>



                    </div>



                    <div class="small-card-icon">



                        <i class="bi bi-grid-fill"></i>



                    </div>



                </div>



                <div class="profile-tool-list">



                    <a asp-controller="Lecturer"



                       asp-action="Courses"



                       class="profile-tool-row">



                        <div class="profile-tool-icon overview-blue">



                            <i class="bi bi-book-half"></i>



                        </div>



                        <div>



                            <strong>My Courses</strong>



                            <span>View your assigned courses</span>



                        </div>



                        <i class="bi bi-chevron-right"></i>



                    </a>



                    <a asp-controller="Lecturer"



                       asp-action="Students"



                       class="profile-tool-row">



                        <div class="profile-tool-icon overview-purple">



                            <i class="bi bi-people-fill"></i>



                        </div>



                        <div>



                            <strong>My Students</strong>



                            <span>View enrollment and progress</span>



                        </div>



                        <i class="bi bi-chevron-right"></i>



                    </a>



                    <a asp-controller="Lecturer"



                       asp-action="Quizzes"



                       class="profile-tool-row">



                        <div class="profile-tool-icon overview-orange">



                            <i class="bi bi-ui-checks-grid"></i>



                        </div>



                        <div>



                            <strong>Quizzes</strong>



                            <span>Manage course quiz questions</span>



                        </div>



                        <i class="bi bi-chevron-right"></i>



                    </a>



                    <a asp-controller="Lecturer"



                       asp-action="Grades"



                       class="profile-tool-row">



                        <div class="profile-tool-icon overview-green">



                            <i class="bi bi-bar-chart-fill"></i>



                        </div>



                        <div>



                            <strong>Quiz Results</strong>



                            <span>Review student quiz performance</span>



                        </div>



                        <i class="bi bi-chevron-right"></i>



                    </a>



                </div>



            </section>



        </aside>



    </div>



</div>
