@model APULMS.Models.User

@{
    Layout = null;
    ViewData["Title"] = "Create Account";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Create Account - APULMS</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

</head>

<body>

<div class="auth-page">

    <!-- =====================================================
         LEFT SIDE
         ===================================================== -->

    <section class="auth-left">

        <div class="auth-overlay-content">

            <div class="apu-badge">
                <i class="bi bi-mortarboard-fill"></i>
                Asia Pacific University
            </div>

            <h1>
                Learn Smarter.
                <span>Progress Faster.</span>
                <span>Graduate Ready.</span>
            </h1>

            <p>
                Join thousands of students building future-ready
                skills through UniLearn LMS.
            </p>

            <!-- STATISTICS -->

            <div class="stats-cards">

                <div class="stat-card">

                    <h3>25K+</h3>

                    <p>
                        Students
                    </p>

                </div>

                <div class="stat-card">

                    <h3>150+</h3>

                    <p>
                        Courses
                    </p>

                </div>

                <div class="stat-card">

                    <h3>95%</h3>

                    <p>
                        Completion Rate
                    </p>

                </div>

                <div class="stat-card">

                    <h3>12K+</h3>

                    <p>
                        Certificates
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         RIGHT SIDE
         ===================================================== -->

    <section class="auth-right">

        <div class="auth-form register-form">

            <!-- HEADER -->

            <div class="auth-header">

                <h2>
                    Create Account
                </h2>

                <p>
                    Start your learning journey today.
                </p>

            </div>


            <!-- REGISTRATION ERROR -->

            @if (TempData["Error"] != null)
            {
                <div class="auth-alert auth-alert-error">

                    <i class="bi bi-exclamation-circle-fill"></i>

                    <span>
                        @TempData["Error"]
                    </span>

                </div>
            }


            @if (ViewBag.Error != null)
            {
                <div class="auth-alert auth-alert-error">

                    <i class="bi bi-exclamation-circle-fill"></i>

                    <span>
                        @ViewBag.Error
                    </span>

                </div>
            }


            <!-- ROLE SELECTION -->

            <div class="role-section">

                <label class="role-label">
                    Register As
                </label>

                <!--
                    Actual value submitted to AccountController.
                    Student is the safe default.
                -->
                <input type="hidden"
                       id="Role"
                       name="Role"
                       form="registerForm"
                       value="@(Model.Role == "lecturer" ? "lecturer" : "student")" />

                <div class="role-select">

                    <button type="button"
                            class="role-card @(Model.Role != "lecturer" ? "active" : "")"
                            data-role="student">

                        <span class="role-icon">🎓</span>

                        <span class="role-text">
                            Student
                        </span>

                    </button>


                    <button type="button"
                            class="role-card @(Model.Role == "lecturer" ? "active" : "")"
                            data-role="lecturer">

                        <span class="role-icon">👨‍🏫</span>

                        <span class="role-text">
                            Lecturer
                        </span>

                    </button>

                </div>

                <span asp-validation-for="Role"
                      class="text-danger">
                </span>

            </div>


            <!-- REGISTER FORM -->

            <form id="registerForm"
                  asp-controller="Account"
                  asp-action="Register"
                  method="post">


                <!-- FULL NAME -->

                <div class="form-group">

                    <label asp-for="Name">
                        Full Name
                    </label>

                    <div class="input-wrapper">

                        <input asp-for="Name"
                               type="text"
                               placeholder="Enter your full name"
                               autocomplete="name" />

                    </div>

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- EMAIL -->

                <div class="form-group">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <input asp-for="Email"
                               type="email"
                               placeholder="Enter your email address"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- PASSWORD -->

                <div class="form-group">

                    <label asp-for="Password">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <input asp-for="Password"
                               type="password"
                               placeholder="Create a password"
                               autocomplete="new-password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label asp-for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <div class="input-wrapper">

                        <input asp-for="ConfirmPassword"
                               type="password"
                               placeholder="Confirm your password"
                               autocomplete="new-password" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>


                <!-- TERMS -->

                <div class="checkbox-group">

                    <input type="checkbox"
                           id="terms"
                           required />

                    <label for="terms">
                        I agree to the Terms & Conditions
                    </label>

                </div>


                <!-- CREATE ACCOUNT BUTTON -->

                <button type="submit"
                        class="auth-btn">

                    <span>
                        Create Account
                    </span>

                    <i class="bi bi-arrow-right"></i>

                </button>

            </form>


            <!-- LOGIN LINK -->

            <div class="auth-links">

                Don't have an account?

                <a asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>

            </div>

        </div>

    </section>

</div>





<script>
document.addEventListener("DOMContentLoaded", function () {

    const roleInput =
        document.getElementById("Role");

    const roleCards =
        document.querySelectorAll(".role-card");

    if (!roleInput || roleCards.length === 0) {
        return;
    }

    roleCards.forEach(function (card) {

        card.addEventListener("click", function () {

            const selectedRole =
                card.getAttribute("data-role");

            if (selectedRole !== "student" &&
                selectedRole !== "lecturer") {
                return;
            }

            roleInput.value = selectedRole;

            roleCards.forEach(function (item) {
                item.classList.remove("active");
            });

            card.classList.add("active");
        });

    });

});
</script>

</body>

</html>