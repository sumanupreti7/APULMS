@using APULMS.Controllers
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Take Quiz";

    var questions =
        ViewBag.QuizQuestions as List<StudentQuizQuestion>
        ?? new List<StudentQuizQuestion>();

    int courseId = ViewBag.CourseId ?? 0;
    string courseTitle = ViewBag.CourseTitle?.ToString() ?? "Course Quiz";
    string category = ViewBag.Category?.ToString() ?? "";
    string lecturerName = ViewBag.LecturerName?.ToString() ?? "Unassigned";
    int questionCount = ViewBag.QuestionCount ?? questions.Count;
}

<div class="take-quiz-page">

    <section class="quiz-header-card">
        <div class="quiz-header-copy">
            <a asp-controller="Student"
               asp-action="Quizzes"
               class="back-link">
                <span>←</span>
                Back to Quizzes
            </a>

            <span class="page-eyebrow">COURSE ASSESSMENT</span>

            <h1>@courseTitle</h1>

            <p>
                Read each question carefully and select one answer
                before submitting your quiz.
            </p>

            <div class="quiz-course-meta">
                @if (!string.IsNullOrWhiteSpace(category))
                {
                    <span>
                        <strong>Category:</strong>
                        @category
                    </span>
                }

                <span>
                    <strong>Lecturer:</strong>
                    @lecturerName
                </span>

                <span>
                    <strong>Questions:</strong>
                    @questionCount
                </span>
            </div>
        </div>

        <div class="quiz-progress-summary">
            <div class="progress-circle" id="progressCircle">
                <strong id="answeredCount">0</strong>
                <span>/ @questionCount</span>
            </div>

            <div>
                <strong>Answered</strong>
                <span id="progressMessage">
                    Complete all questions
                </span>
            </div>
        </div>
    </section>

    @if (TempData["Error"] != null)
    {
        <div class="quiz-alert quiz-alert-error">
            <span>!</span>
            @TempData["Error"]
        </div>
    }

    @if (questions.Count == 0)
    {
        <section class="empty-quiz-card">
            <div class="empty-icon">?</div>

            <h2>No quiz questions available</h2>

            <p>
                This course does not currently have any quiz questions.
            </p>

            <a asp-controller="Student"
               asp-action="Quizzes"
               class="secondary-button">
                Return to Quizzes
            </a>
        </section>
    }
    else
    {
        <form asp-controller="Student"
              asp-action="SubmitQuiz"
              method="post"
              id="studentQuizForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="courseId"
                   value="@courseId" />

            <div class="question-list">

                @for (int index = 0; index < questions.Count; index++)
                {
                    var question = questions[index];
                    int questionNumber = index + 1;

                    <article class="question-card"
                             data-question-id="@question.Id">

                        <div class="question-heading">
                            <div class="question-number">
                                @questionNumber
                            </div>

                            <div class="question-title">
                                <span>
                                    Question @questionNumber
                                    of @questionCount
                                </span>

                                <h2>@question.Question</h2>
                            </div>

                            <div class="question-status"
                                 id="status_@question.Id">
                                Not answered
                            </div>
                        </div>

                        <div class="answer-grid">

                            <label class="answer-option">
                                <input type="radio"
                                       name="answer_@question.Id"
                                       value="A" />

                                <span class="option-letter">A</span>

                                <span class="option-text">
                                    @question.OptionA
                                </span>

                                <span class="option-check">✓</span>
                            </label>

                            <label class="answer-option">
                                <input type="radio"
                                       name="answer_@question.Id"
                                       value="B" />

                                <span class="option-letter">B</span>

                                <span class="option-text">
                                    @question.OptionB
                                </span>

                                <span class="option-check">✓</span>
                            </label>

                            <label class="answer-option">
                                <input type="radio"
                                       name="answer_@question.Id"
                                       value="C" />

                                <span class="option-letter">C</span>

                                <span class="option-text">
                                    @question.OptionC
                                </span>

                                <span class="option-check">✓</span>
                            </label>

                            <label class="answer-option">
                                <input type="radio"
                                       name="answer_@question.Id"
                                       value="D" />

                                <span class="option-letter">D</span>

                                <span class="option-text">
                                    @question.OptionD
                                </span>

                                <span class="option-check">✓</span>
                            </label>

                        </div>
                    </article>
                }

            </div>

            <section class="submit-card">
                <div>
                    <span class="submit-eyebrow">
                        READY TO FINISH?
                    </span>

                    <h2>Submit your answers</h2>

                    <p id="submitMessage">
                        Answer all @questionCount questions before submitting.
                    </p>
                </div>

                <div class="submit-actions">
                    <a asp-controller="Student"
                       asp-action="Quizzes"
                       class="secondary-button">
                        Cancel
                    </a>

                    <button type="submit"
                            class="submit-button"
                            id="submitQuizButton">
                        Submit Quiz
                        <span>→</span>
                    </button>
                </div>
            </section>

        </form>
    }
</div>

<div class="quiz-modal-backdrop"
     id="quizConfirmModal"
     aria-hidden="true">

    <div class="quiz-modal">
        <div class="modal-icon">✓</div>

        <h2>Submit Quiz?</h2>

        <p>
            Your answers will be scored immediately and the result
            will be saved to your APULMS account.
        </p>

        <div class="modal-actions">
            <button type="button"
                    class="secondary-button"
                    id="cancelSubmitButton">
                Continue Reviewing
            </button>

            <button type="button"
                    class="submit-button"
                    id="confirmSubmitButton">
                Yes, Submit Quiz
            </button>
        </div>
    </div>
</div>

<style>
    .take-quiz-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 32px;
        color: #172033;
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .quiz-header-card,
    .question-card,
    .submit-card,
    .empty-quiz-card {
        border: 1px solid #e6eaf1;
        background: #ffffff;
        box-shadow: 0 12px 32px rgba(20, 35, 70, .055);
    }

    .quiz-header-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 30px 32px;
        border-radius: 22px;
    }

    .quiz-header-copy {
        max-width: 820px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 20px;
        color: #667085;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .back-link:hover {
        color: #3157d5;
    }

    .page-eyebrow,
    .submit-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #3157d5;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .quiz-header-copy h1 {
        margin: 0;
        color: #172033;
        font-size: clamp(28px, 3vw, 40px);
        line-height: 1.18;
    }

    .quiz-header-copy > p {
        max-width: 700px;
        margin: 10px 0 0;
        color: #697386;
        line-height: 1.65;
    }

    .quiz-course-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }

    .quiz-course-meta span {
        padding: 8px 11px;
        border-radius: 9px;
        color: #596477;
        background: #f4f6f9;
        font-size: 12px;
    }

    .quiz-progress-summary {
        display: flex;
        align-items: center;
        gap: 14px;
        flex: 0 0 auto;
        padding: 16px 18px;
        border-radius: 16px;
        background: #f7f9ff;
    }

    .progress-circle {
        display: flex;
        align-items: baseline;
        justify-content: center;
        width: 62px;
        height: 62px;
        padding-top: 17px;
        border: 5px solid #dfe6fb;
        border-radius: 50%;
        color: #3157d5;
        background: #ffffff;
    }

    .progress-circle strong {
        font-size: 18px;
    }

    .progress-circle span {
        margin-left: 2px;
        color: #7c879a;
        font-size: 11px;
    }

    .quiz-progress-summary > div:last-child {
        display: grid;
        gap: 3px;
    }

    .quiz-progress-summary > div:last-child strong {
        font-size: 14px;
    }

    .quiz-progress-summary > div:last-child span {
        color: #7c879a;
        font-size: 12px;
    }

    .quiz-alert {
        margin-top: 18px;
        padding: 14px 17px;
        border-radius: 12px;
        font-weight: 650;
    }

    .quiz-alert-error {
        color: #9f2d2d;
        background: #fff0f0;
    }

    .question-list {
        display: grid;
        gap: 20px;
        margin-top: 22px;
    }

    .question-card {
        padding: 25px;
        border-radius: 18px;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .question-card.answered {
        border-color: #cfd8f6;
        box-shadow: 0 12px 30px rgba(49, 87, 213, .07);
    }

    .question-heading {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: flex-start;
        gap: 15px;
    }

    .question-number {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        color: #3157d5;
        background: #edf2ff;
        font-size: 15px;
        font-weight: 800;
    }

    .question-title span {
        display: block;
        margin-bottom: 5px;
        color: #8a94a6;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .question-title h2 {
        margin: 0;
        color: #172033;
        font-size: 18px;
        line-height: 1.5;
    }

    .question-status {
        padding: 6px 9px;
        border-radius: 999px;
        color: #8a94a6;
        background: #f4f6f9;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

    .question-status.complete {
        color: #17663b;
        background: #eaf8f0;
    }

    .answer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 22px;
    }

    .answer-option {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 12px;
        min-height: 68px;
        padding: 13px 15px;
        border: 1px solid #e2e7ef;
        border-radius: 13px;
        cursor: pointer;
        background: #ffffff;
        transition: border-color .18s ease, background .18s ease, transform .18s ease;
    }

    .answer-option:hover {
        transform: translateY(-1px);
        border-color: #bcc9ef;
        background: #fafbff;
    }

    .answer-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .option-letter {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        color: #536078;
        background: #f1f3f7;
        font-size: 13px;
        font-weight: 800;
    }

    .option-text {
        color: #3c4659;
        font-size: 14px;
        line-height: 1.45;
    }

    .option-check {
        display: grid;
        place-items: center;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        color: transparent;
        border: 1px solid #d9dfe8;
        font-size: 12px;
        font-weight: 900;
    }

    .answer-option:has(input:checked) {
        border-color: #3157d5;
        background: #f5f7ff;
    }

    .answer-option:has(input:checked) .option-letter {
        color: #ffffff;
        background: #3157d5;
    }

    .answer-option:has(input:checked) .option-check {
        color: #ffffff;
        border-color: #3157d5;
        background: #3157d5;
    }

    .submit-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-top: 22px;
        padding: 25px 28px;
        border-radius: 18px;
    }

    .submit-card h2 {
        margin: 0;
        font-size: 21px;
    }

    .submit-card p {
        margin: 7px 0 0;
        color: #697386;
        font-size: 13px;
    }

    .submit-actions,
    .modal-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .secondary-button,
    .submit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 11px 17px;
        border-radius: 11px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
    }

    .secondary-button {
        color: #344054;
        border: 1px solid #dce1e9;
        background: #ffffff;
    }

    .submit-button {
        color: #ffffff;
        border: 1px solid #3157d5;
        background: #3157d5;
        box-shadow: 0 8px 18px rgba(49, 87, 213, .17);
    }

    .submit-button:hover,
    .secondary-button:hover {
        transform: translateY(-1px);
    }

    .empty-quiz-card {
        margin-top: 22px;
        padding: 70px 25px;
        border-radius: 20px;
        text-align: center;
    }

    .empty-icon {
        display: grid;
        place-items: center;
        width: 66px;
        height: 66px;
        margin: 0 auto 15px;
        border-radius: 18px;
        color: #3157d5;
        background: #edf2ff;
        font-size: 27px;
        font-weight: 900;
    }

    .empty-quiz-card h2 {
        margin: 0 0 8px;
    }

    .empty-quiz-card p {
        margin: 0 0 20px;
        color: #697386;
    }

    .quiz-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(17, 24, 39, .52);
        backdrop-filter: blur(4px);
    }

    .quiz-modal-backdrop.show {
        display: flex;
    }

    .quiz-modal {
        width: min(460px, 100%);
        padding: 30px;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 24px 70px rgba(0, 0, 0, .2);
        text-align: center;
    }

    .modal-icon {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        border-radius: 50%;
        color: #17663b;
        background: #eaf8f0;
        font-size: 22px;
        font-weight: 900;
    }

    .quiz-modal h2 {
        margin: 0 0 8px;
    }

    .quiz-modal p {
        margin: 0 0 22px;
        color: #697386;
        line-height: 1.6;
    }

    .modal-actions {
        justify-content: center;
    }

    @@media (max-width: 820px) {
        .take-quiz-page {
            padding: 20px;
        }

        .quiz-header-card,
        .submit-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .answer-grid {
            grid-template-columns: 1fr;
        }

        .quiz-progress-summary {
            width: 100%;
        }

        .submit-actions {
            width: 100%;
        }

        .submit-actions > * {
            flex: 1;
        }
    }

    @@media (max-width: 560px) {
        .question-heading {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .question-status {
            grid-column: 1 / -1;
            justify-self: start;
        }

        .modal-actions {
            flex-direction: column;
        }

        .modal-actions > * {
            width: 100%;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("studentQuizForm");

        if (!form) {
            return;
        }

        const questionCards =
            Array.from(document.querySelectorAll(".question-card"));

        const answeredCount =
            document.getElementById("answeredCount");

        const progressMessage =
            document.getElementById("progressMessage");

        const submitMessage =
            document.getElementById("submitMessage");

        const modal =
            document.getElementById("quizConfirmModal");

        const cancelSubmitButton =
            document.getElementById("cancelSubmitButton");

        const confirmSubmitButton =
            document.getElementById("confirmSubmitButton");

        let allowFinalSubmit = false;

        function updateProgress() {
            let answered = 0;

            questionCards.forEach(function (card) {
                const checked =
                    card.querySelector('input[type="radio"]:checked');

                const questionId =
                    card.getAttribute("data-question-id");

                const status =
                    document.getElementById("status_" + questionId);

                if (checked) {
                    answered++;
                    card.classList.add("answered");

                    if (status) {
                        status.textContent = "Answered";
                        status.classList.add("complete");
                    }
                } else {
                    card.classList.remove("answered");

                    if (status) {
                        status.textContent = "Not answered";
                        status.classList.remove("complete");
                    }
                }
            });

            if (answeredCount) {
                answeredCount.textContent = answered;
            }

            if (progressMessage) {
                progressMessage.textContent =
                    answered === questionCards.length
                        ? "All questions answered"
                        : (questionCards.length - answered) +
                          " question(s) remaining";
            }

            if (submitMessage) {
                submitMessage.textContent =
                    answered === questionCards.length
                        ? "All questions are answered. You can submit your quiz."
                        : "Answer all " +
                          questionCards.length +
                          " questions before submitting.";
            }

            return answered;
        }

        form.addEventListener("change", function (event) {
            if (event.target.matches('input[type="radio"]')) {
                updateProgress();
            }
        });

        form.addEventListener("submit", function (event) {
            if (allowFinalSubmit) {
                return;
            }

            event.preventDefault();

            const answered = updateProgress();

            if (answered !== questionCards.length) {
                const firstUnanswered =
                    questionCards.find(function (card) {
                        return !card.querySelector(
                            'input[type="radio"]:checked'
                        );
                    });

                if (firstUnanswered) {
                    firstUnanswered.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    firstUnanswered.animate(
                        [
                            { transform: "translateX(0)" },
                            { transform: "translateX(-5px)" },
                            { transform: "translateX(5px)" },
                            { transform: "translateX(0)" }
                        ],
                        {
                            duration: 320
                        }
                    );
                }

                return;
            }

            if (modal) {
                modal.classList.add("show");
                modal.setAttribute("aria-hidden", "false");
            }
        });

        if (cancelSubmitButton) {
            cancelSubmitButton.addEventListener(
                "click",
                function () {
                    if (modal) {
                        modal.classList.remove("show");
                        modal.setAttribute("aria-hidden", "true");
                    }
                }
            );
        }

        if (confirmSubmitButton) {
            confirmSubmitButton.addEventListener(
                "click",
                function () {
                    allowFinalSubmit = true;

                    confirmSubmitButton.disabled = true;
                    confirmSubmitButton.textContent = "Submitting...";

                    form.submit();
                }
            );
        }

        if (modal) {
            modal.addEventListener("click", function (event) {
                if (event.target === modal) {
                    modal.classList.remove("show");
                    modal.setAttribute("aria-hidden", "true");
                }
            });
        }

        updateProgress();
    });
</script>
