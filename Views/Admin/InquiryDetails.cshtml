@model APULMS.Models.ContactInquiry

@{
    ViewData["Title"] = "Inquiry Details";

    string emailSubject =
        Uri.EscapeDataString(
            "RE: " + Model.Subject);

    string emailBody =
        Uri.EscapeDataString(
            Model.AdminReply ?? "");

    string mailTo =
        $"mailto:{Model.Email}?subject={emailSubject}&body={emailBody}";
}

<style>
    .inq-detail-page {
        padding: 30px;
        max-width: 1100px;
        margin: auto;
    }

    .inq-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .inq-detail-header span {
        color: #1976d2;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

    .inq-detail-header h1 {
        margin: 7px 0 0;
        color: #102a43;
        font-size: 30px;
    }

    .inq-back {
        padding: 11px 17px;
        border: 1px solid #dfe8f1;
        border-radius: 10px;
        text-decoration: none;
        color: #29445c;
        background: #fff;
        font-weight: 700;
    }

    .inq-detail-grid {
        display: grid;
        grid-template-columns: 1.05fr .95fr;
        gap: 22px;
    }

    .inq-card {
        background: #fff;
        border: 1px solid #e3ebf3;
        border-radius: 18px;
        padding: 26px;
    }

    .inq-card h2 {
        color: #102a43;
        margin: 0 0 22px;
        font-size: 21px;
    }

    .inq-meta {
        margin-bottom: 18px;
    }

    .inq-meta small {
        display: block;
        color: #8395a6;
        text-transform: uppercase;
        font-size: 11px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .inq-meta strong,
    .inq-meta a {
        color: #29445c;
        text-decoration: none;
    }

    .inq-message {
        margin-top: 22px;
        padding: 18px;
        border-radius: 12px;
        background: #f6f9fc;
        color: #354f65;
        line-height: 1.7;
        white-space: pre-wrap;
    }

    .inq-status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 30px;
        background: #fff5dc;
        color: #946300;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .inq-reply textarea {
        width: 100%;
        min-height: 190px;
        box-sizing: border-box;
        resize: vertical;
        border: 1px solid #d9e4ee;
        border-radius: 12px;
        padding: 14px;
        font-family: inherit;
        font-size: 14px;
        outline: none;
        margin-bottom: 15px;
    }

    .inq-reply textarea:focus {
        border-color: #1976d2;
        box-shadow: 0 0 0 4px rgba(25,118,210,.08);
    }

    .inq-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .inq-save {
        border: none;
        background: #1976d2;
        color: #fff;
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
    }

    .inq-email-button {
        background: #f1f6fb;
        color: #29445c;
        border: 1px solid #dce7f0;
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
    }

    .inq-note {
        margin-top: 15px;
        color: #8293a3;
        font-size: 12px;
        line-height: 1.6;
    }

    @@media (max-width: 800px) {
        .inq-detail-grid {
            grid-template-columns: 1fr;
        }

        .inq-detail-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="inq-detail-page">

    <div class="inq-detail-header">

        <div>
            <span>ADMIN PORTAL</span>
            <h1>Inquiry Details</h1>
        </div>

        <a asp-controller="Admin"
           asp-action="Inquiries"
           class="inq-back">
            ← Back to Inquiries
        </a>

    </div>


    @if (TempData["InquirySuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["InquirySuccess"]
        </div>
    }

    @if (TempData["InquiryError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["InquiryError"]
        </div>
    }


    <div class="inq-detail-grid">

        <div class="inq-card">

            <h2>Guest Message</h2>

            <div class="inq-meta">
                <small>From</small>
                <strong>@Model.Name</strong>
            </div>

            <div class="inq-meta">
                <small>Email Address</small>

                <a href="mailto:@Model.Email">
                    @Model.Email
                </a>
            </div>

            <div class="inq-meta">
                <small>Subject</small>
                <strong>@Model.Subject</strong>
            </div>

            <div class="inq-meta">
                <small>Received</small>

                <strong>
                    @Model.CreatedAt.ToString(
                        "dd MMMM yyyy, hh:mm tt")
                </strong>
            </div>

            <div class="inq-meta">
                <small>Status</small>

                <span class="inq-status">
                    @Model.Status
                </span>
            </div>

            <div class="inq-message">@Model.Message</div>

        </div>


        <div class="inq-card inq-reply">

            <h2>Admin Response</h2>

            <form asp-controller="Admin"
                  asp-action="ReplyInquiry"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <textarea name="adminReply"
                          maxlength="5000"
                          placeholder="Write your response to the guest..."
                          required>@Model.AdminReply</textarea>

                <div class="inq-actions">

                    <button type="submit"
                            class="inq-save">
                        Save Response
                    </button>

                    <a href="@mailTo"
                       class="inq-email-button">
                        Reply by Email
                    </a>

                </div>

            </form>

            @if (Model.RepliedAt.HasValue)
            {
                <div class="inq-note">
                    Last response saved:
                    <strong>
                        @Model.RepliedAt.Value.ToString(
                            "dd MMM yyyy, hh:mm tt")
                    </strong>
                </div>
            }

            <div class="inq-note">
                Saving a response records it in APULMS and marks
                this inquiry as replied. "Reply by Email" opens
                your email application; APULMS does not send the
                email automatically.
            </div>

        </div>

    </div>

</div>
