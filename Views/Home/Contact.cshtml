<!-- =========================================================
     SUCCESS MESSAGE
     ========================================================= -->
@if (TempData["ContactSuccess"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const message =
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        TempData["ContactSuccess"]?.ToString()
                    )
                );

            if (typeof Swal !== "undefined") {

                Swal.fire({
                    title: "Inquiry Sent!",
                    text: message,
                    icon: "success",
                    confirmButtonText: "OK"
                });

            }
            else {
                alert(message);
            }

        });
    </script>
}


<!-- =========================================================
     ERROR MESSAGE
     ========================================================= -->
@if (TempData["ContactError"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const message =
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        TempData["ContactError"]?.ToString()
                    )
                );

            if (typeof Swal !== "undefined") {

                Swal.fire({
                    title: "Unable to Send Inquiry",
                    text: message,
                    icon: "error",
                    confirmButtonText: "Try Again"
                });

            }
            else {
                alert(message);
            }

        });
    </script>
}
