                <div class="contact-form-card">

                    <div class="contact-form-header">

                        <span>GUEST INQUIRY</span>

                        <h2>Send an Inquiry</h2>

                        <p>
                            Have a question about APULMS, available courses
                            or platform access? Complete the form below and
                            the administration team can review your inquiry.
                        </p>

                    </div>


                    <form asp-controller="Home"
                          asp-action="Contact"
                          method="post"
                          class="contact-form">

                        @Html.AntiForgeryToken()


                        <!-- Name + Email -->
                        <div class="contact-form-row">

                            <div class="contact-field">

                                <label for="name">
                                    Full Name
                                </label>

                                <input type="text"
                                       id="name"
                                       name="name"
                                       placeholder="Enter your full name"
                                       maxlength="100"
                                       autocomplete="name"
                                       required />

                            </div>


                            <div class="contact-field">

                                <label for="email">
                                    Email Address
                                </label>

                                <input type="email"
                                       id="email"
                                       name="email"
                                       placeholder="Enter your email"
                                       maxlength="150"
                                       autocomplete="email"
                                       required />

                            </div>

                        </div>


                        <!-- Subject -->
                        <div class="contact-field">

                            <label for="subject">
                                Subject
                            </label>

                            <input type="text"
                                   id="subject"
                                   name="subject"
                                   placeholder="What is your inquiry about?"
                                   maxlength="200"
                                   required />

                        </div>


                        <!-- Message -->
                        <div class="contact-field">

                            <label for="message">
                                Message
                            </label>

                            <textarea id="message"
                                      name="message"
                                      placeholder="Write your inquiry here..."
                                      maxlength="2000"
                                      required></textarea>

                        </div>


                        <!-- Submit -->
                        <button type="submit"
                                class="contact-submit">

                            Send Inquiry

                            <svg width="18" height="18"
                                 viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="m22 2-7 20-4-9-9-4z"/>
                                <path d="M22 2 11 13"/>
                            </svg>

                        </button>

                    </form>

