@{
    ViewData["Title"] = "About APULMS";
}

<div class="about-page">

    <!-- HERO -->
    <section class="about-hero">
        <div class="about-content">

            <div class="hero-badge">
                <i class="bi bi-mortarboard-fill"></i>
                APU Learning Management System
            </div>

            <h1>About APULMS</h1>

            <p>
                APULMS is a web-based learning management system that provides
                a central place for students, lecturers and administrators to
                access and manage academic learning activities.
            </p>

        </div>
    </section>


    <!-- PURPOSE -->
    <section class="mission-section">

        <div class="section-heading">
            <span class="section-label">OUR PURPOSE</span>

            <h2>
                A Simple Platform for
                <span>Digital Learning</span>
            </h2>

            <p>
                APULMS brings course information, student enrolment,
                learning progress, quizzes and results together in one
                organized web application.
            </p>
        </div>

        <div class="mission-grid">

            <div class="mission-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z"/>
    <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z"/>
</svg>
                <h3>Course Access</h3>
                <p>
                    Students can browse available courses, enrol in courses
                    and view their learning information from one place.
                </p>
            </div>

            <div class="mission-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="8" cy="7" r="3"/>
    <path d="M2.5 18c0-3.2 2.4-5.5 5.5-5.5s5.5 2.3 5.5 5.5"/>
    <rect x="14" y="5" width="7" height="8" rx="1.2"/>
    <path d="M17.5 13v4M15 17h5"/>
</svg>
                <h3>Lecturer Management</h3>
                <p>
                    Lecturers can manage their courses, review enrolled
                    students, create quizzes and view quiz results.
                </p>
            </div>

            <div class="mission-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2.5 20 6v5.3c0 5-3.2 8.5-8 10.2-4.8-1.7-8-5.2-8-10.2V6l8-3.5Z"/>
    <path d="m8.3 12 2.4 2.4 5-5"/>
</svg>
                <h3>Administration</h3>
                <p>
                    Administrators can manage users and courses and review
                    key system information through the administration portal.
                </p>
            </div>

        </div>
    </section>


    <!-- USER ROLES -->
    <section class="why-section">

        <div class="section-heading">
            <span class="section-label">WHO CAN USE APULMS</span>

            <h2>
                Designed for
                <span>Four Types of Access</span>
            </h2>

            <p>
                Access to APULMS depends on whether the visitor is a guest
                or a registered user.
            </p>
        </div>

        <div class="why-grid">

            <div class="why-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="9"/>
    <path d="M3 12h18M12 3c2.4 2.5 3.5 5.5 3.5 9S14.4 18.5 12 21M12 3C9.6 5.5 8.5 8.5 8.5 12S9.6 18.5 12 21"/>
</svg>
                <h3>Guest</h3>
                <p>
                    Non-registered visitors can view general information,
                    explore the public course catalogue and access
                    registration and login pages.
                </p>
            </div>

            <div class="why-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="m2.5 9 9.5-5 9.5 5-9.5 5-9.5-5Z"/>
    <path d="M6 11.2V16c3.7 2.8 8.3 2.8 12 0v-4.8M21.5 9v6"/>
</svg>
                <h3>Student</h3>
                <p>
                    Registered students can enrol in courses, monitor
                    progress, take quizzes, view results and manage
                    their profile.
                </p>
            </div>

            <div class="why-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="8" cy="7" r="3"/>
    <path d="M2.5 19c0-3.5 2.3-5.8 5.5-5.8s5.5 2.3 5.5 5.8"/>
    <rect x="14.5" y="5" width="7" height="9" rx="1.2"/>
    <path d="M17 17h2M18 14v3"/>
</svg>
                <h3>Lecturer</h3>
                <p>
                    Lecturers can manage assigned courses, view enrolled
                    students, manage quizzes and review student quiz results.
                </p>
            </div>

            <div class="why-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="8" cy="7" r="3"/>
    <path d="M2.5 19c0-3.5 2.3-5.8 5.5-5.8 2 0 3.6.8 4.6 2.1"/>
    <circle cx="17.5" cy="16.5" r="3"/>
    <path d="M17.5 11.8v1.7M17.5 19.5v1.7M12.8 16.5h1.7M20.5 16.5h1.7M14.2 13.2l1.2 1.2M19.6 18.6l1.2 1.2M20.8 13.2l-1.2 1.2M15.4 18.6l-1.2 1.2"/>
</svg>
                <h3>Administrator</h3>
                <p>
                    Administrators manage users, courses, students and
                    lecturers and can review system reports.
                </p>
            </div>

        </div>
    </section>


    <!-- KEY FUNCTIONS -->
    <section class="mission-section">

        <div class="section-heading">
            <span class="section-label">KEY FUNCTIONS</span>

            <h2>
                What APULMS
                <span>Provides</span>
            </h2>

            <p>
                The system focuses on the essential learning-management
                functions implemented in this project.
            </p>
        </div>

        <div class="mission-grid">

            <div class="mission-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="8" cy="7" r="3"/>
    <path d="M2.5 19c0-3.5 2.3-5.8 5.5-5.8 1.6 0 3 .5 4 1.5"/>
    <path d="m14 16.5 2.2 2.2 4.5-5"/>
</svg>
                <h3>Account & Role Access</h3>
                <p>
                    Registration, login, session-based access and separate
                    portals for students, lecturers and administrators.
                </p>
            </div>

            <div class="mission-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 3.5h13a2 2 0 0 1 2 2V21H6a2 2 0 0 1-2-2V4.5a1 1 0 0 1 1-1Z"/>
    <path d="M8 3.5v7l2.5-1.7L13 10.5v-7M7 16h9"/>
</svg>
                <h3>Courses & Enrolment</h3>
                <p>
                    Course information is available publicly, while registered
                    students can enrol and track course progress.
                </p>
            </div>

            <div class="mission-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="2"/>
    <path d="m6.5 8 1.4 1.4 2.5-3M13 8h5M6.5 15l1.4 1.4 2.5-3M13 15h5"/>
</svg>
                <h3>Quizzes & Results</h3>
                <p>
                    Students can take course quizzes and view results while
                    lecturers can manage quiz questions and review attempts.
                </p>
            </div>

        </div>
    </section>


    <!-- IMPLEMENTATION -->
    <section class="why-section">

        <div class="section-heading">
            <span class="section-label">SYSTEM IMPLEMENTATION</span>

            <h2>
                Built for
                <span>Web Application Learning</span>
            </h2>

            <p>
                APULMS is implemented using ASP.NET Core MVC and C# with
                Razor views. Database operations use ADO.NET-style
                MySQL connectivity through MySqlConnector.
            </p>
        </div>

        <div class="why-grid">

            <div class="why-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="2.5" y="4" width="19" height="16" rx="2"/>
    <path d="M2.5 8h19M6 6h.01M9 6h.01"/>
</svg>
                <h3>ASP.NET Core MVC</h3>
                <p>
                    Controllers, models and Razor views are used to organize
                    the web application and its user-facing pages.
                </p>
            </div>

            <div class="why-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <ellipse cx="12" cy="5.5" rx="8" ry="3"/>
    <path d="M4 5.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>
    <path d="M4 11.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>
</svg>
                <h3>ADO.NET Database Access</h3>
                <p>
                    MySqlConnection, MySqlCommand and data readers are used
                    to communicate with the MySQL database.
                </p>
            </div>

            <div class="why-card">
                
<svg class="about-card-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4 10 20"/>
</svg>
                <h3>Web Interface</h3>
                <p>
                    Razor, HTML, CSS, Bootstrap and JavaScript provide a
                    responsive interface for public and authenticated users.
                </p>
            </div>

        </div>
    </section>


    <!-- CTA -->
    <section class="about-cta">

        <div class="cta-content">

            <span class="section-label">EXPLORE APULMS</span>

            <h2>
                Discover the
                <span>Available Courses</span>
            </h2>

            <p>
                You can browse course information as a guest.
                Create a student account when you are ready to enrol
                and use the learning features.
            </p>

            <div class="cta-buttons">

                <a asp-controller="Home"
                   asp-action="Courses"
                   class="btn btn-primary">
                    Explore Courses
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-outline-primary">
                    Create Student Account
                </a>

            </div>

        </div>
    </section>

</div>
