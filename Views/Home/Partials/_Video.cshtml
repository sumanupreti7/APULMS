<section class="home-video-section" id="video">
    <div class="home-video-container">

        <div class="home-video-media">
            <div class="home-video-frame">
                <iframe
                    src="https://www.youtube.com/embed/dQw4w9WgXcQ"
                    title="APULMS Introduction Video"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen>
                </iframe>
            </div>
        </div>

        <div class="home-video-content">

            <span class="home-video-eyebrow">
                DIGITAL LEARNING EXPERIENCE
            </span>

            <h2>
                Learn Anytime, Anywhere
                <span>with APULMS</span>
            </h2>

            <p class="home-video-description">
                APULMS provides students and lecturers with a modern
                digital learning environment where courses, resources,
                assessments, and communication are available in one place.
            </p>

            <div class="home-video-features">
                <div class="home-video-feature">
                    <span class="home-video-check">✓</span>
                    <span>Access courses and learning resources</span>
                </div>

                <div class="home-video-feature">
                    <span class="home-video-check">✓</span>
                    <span>Manage assessments and learning progress</span>
                </div>

                <div class="home-video-feature">
                    <span class="home-video-check">✓</span>
                    <span>Learn from anywhere, anytime</span>
                </div>
            </div>

            <p class="home-video-secondary">
                Explore our platform and experience a smarter way of learning.
            </p>

            <a asp-controller="Account"
               asp-action="Register"
               class="home-video-button">
                Start Learning
                <span aria-hidden="true">→</span>
            </a>

        </div>

    </div>
</section>